[Unit]
Description=Cloudflare free conversational supervisor
After=network-online.target
Wants=network-online.target
[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/cyber-quiz
Environment=PATH=/home/ec2-user/cyber-quiz/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ec2-user/cyber-quiz/.venv/bin/python -m cyberquiz.conversation
Restart=always
RestartSec=5
MemoryMax=90M
UMask=0077
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
[Install]
WantedBy=multi-user.target
