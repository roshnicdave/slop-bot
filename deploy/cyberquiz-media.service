[Unit]
Description=HTTPS media for Instagram ingestion
After=network-online.target
Wants=network-online.target
[Service]
User=ec2-user
Group=ec2-user
ExecStart=/usr/local/bin/caddy run --config /home/ec2-user/cyber-quiz/deploy/Caddyfile --adapter caddyfile
ExecReload=/usr/local/bin/caddy reload --config /home/ec2-user/cyber-quiz/deploy/Caddyfile --adapter caddyfile
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
Restart=on-failure
RestartSec=10
[Install]
WantedBy=multi-user.target
