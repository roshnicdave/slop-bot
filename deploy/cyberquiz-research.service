[Unit]
Description=Daily topic-wide Reel discovery and bounded example inspection
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/cyber-quiz
Environment=PATH=/home/ec2-user/cyber-quiz/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ec2-user/cyber-quiz/.venv/bin/python -m cyberquiz.research
TimeoutStartSec=12min
MemoryMax=140M
CPUQuota=50%
Nice=19
UMask=0077
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
